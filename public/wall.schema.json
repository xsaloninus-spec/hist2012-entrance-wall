{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wall.schema.json",
  "title": "Continuous Entrance Wall Configuration",
  "type": "object",
  "required": ["version", "wall", "zones", "objects", "tour"],
  "properties": {
    "version": { "type": "string" },
    "wall": {
      "type": "object",
      "required": ["length", "height", "bays", "caseStart", "caseEnd"],
      "properties": {
        "length": { "const": 18 },
        "height": { "const": 3.4 },
        "bays": { "const": 8 },
        "caseStart": { "const": 4.2 },
        "caseEnd": { "const": 16.2 }
      }
    },
    "zones": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "bay", "label", "x", "y", "w", "h", "lines", "align", "style", "text"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "bay": { "type": "integer", "minimum": 0, "maximum": 7 },
          "label": { "type": "string" },
          "x": { "type": "number", "minimum": 0, "maximum": 18 },
          "y": { "type": "number", "minimum": 0, "maximum": 3.4 },
          "w": { "type": "number", "exclusiveMinimum": 0 },
          "h": { "type": "number", "exclusiveMinimum": 0 },
          "words": { "type": "integer", "minimum": 1 },
          "chars": { "type": "integer", "minimum": 1 },
          "lines": { "type": "integer", "minimum": 1 },
          "align": { "enum": ["left", "center", "right"] },
          "style": { "enum": ["title", "verticalTitle", "subtitle", "body", "section", "object", "caption", "meta"] },
          "text": {
            "type": "object",
            "required": ["en", "zh"],
            "properties": { "en": { "type": "string" }, "zh": { "type": "string" } }
          }
        }
      }
    },
    "objects": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": ["id", "bay", "proxy"],
        "properties": {
          "id": { "type": "string" },
          "bay": { "type": "integer", "minimum": 1, "maximum": 6 },
          "proxy": {
            "type": "object",
            "required": ["w", "h", "d"],
            "properties": { "w": { "type": "number", "maximum": 0.25 }, "h": { "type": "number", "maximum": 0.25 }, "d": { "type": "number", "maximum": 0.25 } }
          }
        }
      }
    },
    "tour": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["t", "position", "lookAt"],
        "properties": {
          "t": { "type": "number", "minimum": 0, "maximum": 90 },
          "position": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "number" } },
          "lookAt": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "number" } }
        }
      }
    }
  }
}
